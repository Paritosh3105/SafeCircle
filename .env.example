# Generate local keys with npm run setup:local. Never commit .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
STORE_MODE=memory
DATABASE_URL=postgresql://safecircle:local-dev-only@localhost:5432/safecircle
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TOKEN_HASH_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# LOCAL MEMORY MODE IS FOR SYNTHETIC DEVELOPMENT DATA ONLY.
# PostgreSQL is the durable storage path. Real deployment needs security review.
