{
  "name": "@safecircle/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "node --import tsx --env-file=../../.env src/migrate.ts",
    "staff:provision": "node --import tsx --env-file=../../.env src/provision-staff.ts"
  },
  "dependencies": {
    "@safecircle/contracts": "0.1.0",
    "fastify": "5.12.5",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/pg": "^8.15.5"
  }
}
